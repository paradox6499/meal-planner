# systemd-юнит для сервера «Съедим» на VPS. Положить в /etc/systemd/system/sedim.service,
# затем: sudo systemctl daemon-reload && sudo systemctl enable --now sedim
# Секреты — в /etc/sedim/env (chmod 600, владелец root), НЕ в этом файле и не в git.
[Unit]
Description=Sedim server (Telegram Mini App backend)
After=network-online.target
Wants=network-online.target

[Service]
User=sedim
Group=sedim
WorkingDirectory=/opt/sedim/server
EnvironmentFile=/etc/sedim/env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
# Один процесс — инвариант (лимиты и сверка платежей живут в памяти), поэтому никаких
# нескольких экземпляров и «масштабирования».
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Писать можно только в каталог с базой.
ReadWritePaths=/var/lib/sedim
# Не убивать посреди записи: даём время закрыться.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
