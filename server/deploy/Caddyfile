# Caddy сам получает и продлевает сертификат Let's Encrypt (нужны открытые порты 80 и 443
# и A-запись домена на IP сервера). Положить в /etc/caddy/Caddyfile, заменить домен.
# После: sudo systemctl reload caddy
api.example.ru {
	encode gzip
	# Сервер слушает только 127.0.0.1:3000 (HOST=127.0.0.1 в /etc/sedim/env).
	# Caddy сам проставляет X-Forwarded-For с реальным адресом клиента — по нему
	# сервер считает лимиты запросов; присланный клиентом заголовок не доверяется.
	reverse_proxy 127.0.0.1:3000
}
