# Скопировать в .env для локального запуска (npm start подхватит через
# любой способ, которым вы прокинете переменные окружения — .env файл сам
# по себе Node не читает без доп. библиотеки, для локального теста удобнее
# просто экспортировать переменные в терминале, см. server/README.md).
# На хостинге эти же переменные задаются в его собственном UI — .env туда не грузится.

TELEGRAM_BOT_TOKEN=
PORT=3000
DB_PATH=./data.db
REMINDER_TICK_MS=300000
